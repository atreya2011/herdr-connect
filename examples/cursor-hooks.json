{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "herdr-connect-rs activity --vendor cursor"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "herdr-connect-rs hook --vendor cursor",
        "timeout": 30000,
        "failClosed": true
      }
    ]
  }
}
