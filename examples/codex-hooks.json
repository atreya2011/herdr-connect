{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "herdr-connect-rs activity --vendor codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "herdr-connect-rs hook --vendor codex",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
